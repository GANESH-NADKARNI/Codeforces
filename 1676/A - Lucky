#include <bits/stdc++.h>
using namespace std;
 
void solve() {
    string s;
    cin >> s;
 
    int first = 0, second = 0;
 
    for (int i = 0; i < 3; i++) {
        first += s[i] - '0';
        second += s[i + 3] - '0';
    }
 
    cout << (first == second ? "YES" : "NO") << '
';
}
 
int main() {
 
 
    int t;
    cin >> t;
 
    while (t--) {
        solve();
    }
 
    return 0;
}